# Copy this file to .env.local and fill in your Supabase project's values.
# See docs/phase-1-plan.md "First-run setup".

# Safe to expose in the browser — protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Only read by src/lib/supabase/admin.ts, only used by src/app/admin/actions.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SERVER-ONLY. Powers both the Research Agent ("运行研究") and the Content
# Agent ("生成内容") on the Topic Detail page. Never prefix with
# NEXT_PUBLIC_. Only read by src/lib/ai/research-agent.ts and
# src/lib/ai/content-agent.ts. Without this set, those actions are
# disabled with an inline notice rather than failing silently.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional. Both default to claude-opus-5 if unset.
RESEARCH_MODEL=claude-opus-5
CONTENT_MODEL=claude-opus-5
