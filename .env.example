# Copy this file to .env.local and fill in your Supabase project's values.
# See docs/phase-1-plan.md "First-run setup".

# Safe to expose in the browser — protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY. Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
# Only read by src/lib/supabase/admin.ts, only used by src/app/admin/actions.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Multi-provider AI Model Router — see docs/model-router.md ---------

# When "true", the Model Router prefers models marked FREE +
# development_recommended in src/lib/ai/providers/registry.ts for any task
# without an ADMIN-configured default. There is no automatic FREE → PAID
# fallback: if no free model satisfies a task, the task fails with a clear
# message rather than silently spending money. Set to "false" (or unset)
# for production-style routing, which then requires an explicit default
# per task (set in /admin/ai-models).
AI_DEVELOPMENT_MODE=true

# SERVER-ONLY. One of four possible providers for the Model Router — never
# prefix with NEXT_PUBLIC_. Any subset may be configured; unconfigured
# providers stay visible but marked "未配置" everywhere (Admin settings,
# generation buttons) rather than breaking the rest of the app. Only read
# by src/lib/ai/research-agent.ts, src/lib/ai/content-agent.ts, and
# src/lib/ai/providers/*.

# Powers the Anthropic provider (Research Agent's real web search +
# Content Agent's structured output). Existing behavior, unchanged.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Powers the Google provider (Gemini) — Research Agent's Google Search
# grounding + Content Agent's structured JSON output.
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key

# Powers the Groq provider — fast, free-tier-friendly drafting/
# classification models. No web-search capability; never used for RESEARCH.
GROQ_API_KEY=your-groq-api-key

# Powers the OpenRouter provider — experimental multi-model access via
# OpenAI-compatible REST. No web-search capability; never used for
# RESEARCH. Used primarily for manual experimentation / A-B testing.
OPENROUTER_API_KEY=your-openrouter-api-key

# Optional. Both default to claude-opus-5 if unset. Only relevant when the
# Model Router actually selects the ANTHROPIC provider for a task.
RESEARCH_MODEL=claude-opus-5
CONTENT_MODEL=claude-opus-5

# --- Search Router — see docs/search-router.md ---------------------------

# SERVER-ONLY. Powers the Tavily Search provider — the current
# Development Mode default (Tavily retrieves real sources, then the
# resolved AI model analyses them — see docs/search-router.md). Never
# prefix with NEXT_PUBLIC_. Only read by
# src/lib/search/providers/tavily-provider.ts. Free tier: 1,000 API
# credits/month, no credit card required (confirmed 2026-08-20).
TAVILY_API_KEY=your-tavily-api-key

# SERVER-ONLY. Powers the Brave Search provider — registered, tested, and
# available, but NOT the Development Mode default: Brave removed its free
# API tier in 2026-02 (confirmed live), so it's registered as PAID and
# Development Mode's free-first search never auto-selects it. Using Brave
# requires an explicit override (no UI control for this yet — see
# docs/search-router.md "Using Brave despite the paid tier"). Never prefix
# with NEXT_PUBLIC_. Only read by src/lib/search/providers/brave-provider.ts.
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
